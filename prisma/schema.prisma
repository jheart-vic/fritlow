// Prisma schema — the single source of truth for the database structure.
// Each `model` becomes a table in Postgres. Run `npm run db:migrate` after
// changing this file to generate + apply a SQL migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Roles a user can hold inside a workspace (RBAC).
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// Platform-level role (Fritlow staff), DELIBERATELY distinct from WorkspaceRole
// (OWNER/ADMIN/MEMBER, per-tenant) — no shared value, so a workspace ADMIN has
// zero platform power and vice versa. USER = a normal end user. SUPPORT =
// Fritlow support staff. SUPERADMIN = full platform admin (seeded from .env,
// never self-serve). Both staff roles reach the /api/v1/admin surface.
enum PlatformRole {
  USER
  SUPPORT
  SUPERADMIN
}

// Lifecycle of a workspace invitation.
// PENDING → ACCEPTED (the invitee joined), DECLINED (the invitee said no),
// REVOKED (the inviter cancelled), or EXPIRED (nobody acted in time).
// DECLINED and REVOKED are kept distinct so the inviter can tell "they turned
// me down" from "I changed my mind" when looking at the history.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  DECLINED
  EXPIRED
}

// Who authored a chat message in the project AI assistant.
enum ChatRole {
  USER
  ASSISTANT
}

// What an in-app notification is about — drives its icon and how the frontend
// builds the click-through link from the `data` payload.
enum NotificationType {
  SUPPORT_REPLY
  WORKSPACE_INVITE
  COMMENT_REPLY
  COMMENT_ADDED
  RECOMMENDATION_CREATED
  GROUP_MENTION
  // A project left a workspace you belong to, so you can no longer see it.
  // Sent because a move is otherwise silent — the project simply vanishes
  // from the dashboards of everyone who had access.
  PROJECT_MOVED
  // A workspace you belonged to was deleted by its owner, taking every
  // project in it. Nothing survives to link to, so this is the only record
  // the other members get that their work is gone.
  WORKSPACE_DELETED
}

// Support conversation lifecycle (Fritlow staff ↔ a user).
enum SupportStatus {
  OPEN
  CLOSED
}

// Who wrote a support message — snapshotted on the message so it survives the
// sender's later role changes (or account deletion → reassigned to sentinel).
enum SupportSenderType {
  USER
  STAFF
}

// The project lifecycle shown on the Projects screen:
// Draft → Discovery → Blueprint Complete → Launched.
enum ProjectStatus {
  DRAFT
  DISCOVERY
  BLUEPRINT_COMPLETE
  LAUNCHED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  fullName        String
  passwordHash    String
  // Profile photo. Null = render initials. Holds the Cloudinary secure_url of
  // the uploaded avatar (upload handled in the settings module).
  avatarUrl       String?
  // Null until the user clicks the verification link; the timestamp (not a
  // boolean) records WHEN they verified — useful for audits later.
  emailVerifiedAt DateTime?
  platformRole    PlatformRole @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Where projects land when the caller doesn't name a workspace. Explicit
  // pointer rather than "whichever workspace looks personal" — a user may own
  // several private workspaces, so the default has to be stated, not inferred.
  // SetNull (not Cascade) because losing the workspace must not delete the user;
  // a null pointer makes createProject ask them to pick instead of guessing.
  defaultWorkspace   Workspace? @relation("UserDefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  defaultWorkspaceId String?

  memberships        WorkspaceMember[]
  blueprintSectionsUpdated BlueprintSection[] @relation("BlueprintSectionUpdatedBy")
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  createdProjects Project[]
  decisions       DecisionLog[]
  exports         Export[]
  blueprintSectionVersions BlueprintSectionVersion[]
  sentInvitations WorkspaceInvitation[]
  comments        Comment[]
  supportConversations SupportConversation[] @relation("SupportCustomer")
  assignedSupport      SupportConversation[] @relation("SupportAssignee")
  supportMessages      SupportMessage[]      @relation("SupportSender")
  notifications        Notification[]
  chatConversations    ChatConversation[]
  groupChannelsCreated GroupChannel[]     @relation("GroupChannelCreator")
  groupMessages        GroupMessage[]     @relation("GroupMessageSender")
  groupChannelReads    GroupChannelRead[]
  uploadedDocuments    ProjectDocument[]

  // Postgres does not index foreign keys automatically. Without this, deleting
  // a workspace seq-scans User to apply the SetNull.
  @@index([defaultWorkspaceId])
}

// Tenancy root: every project lives inside a workspace, and workspace
// membership is the ONLY sharing boundary — access is never per project.
// Users get one private workspace automatically at registration.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  // Private = collaborators can never be invited here; the invite endpoint
  // refuses it outright rather than warning, because membership is
  // workspace-wide and would hand over every project in one go.
  //
  // This flag says NOTHING about where new projects land — that is
  // User.defaultWorkspaceId. Keeping the two apart is what lets a user hold
  // several private workspaces (or none) without new projects going astray.
  isPrivate Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  projects    Project[]
  invitations WorkspaceInvitation[]
  channels    GroupChannel[]
  // Users pointing here as their default. Named relation because User already
  // reaches Workspace through WorkspaceMember; Prisma needs them disambiguated.
  defaultForUsers User[] @relation("UserDefaultWorkspace")
}

enum AiCallStatus {
  SUCCESS
  ERROR
}

// Audit log of every AI call (PRD: log all interactions end to end).
// Deliberately relation-free: log rows must survive user/project deletion.
model AiInteraction {
  id           String       @id @default(uuid())
  feature      String // which product feature made the call, e.g. "discovery.follow_up"
  provider     String // "anthropic", later "openai" | "gemini"
  model        String
  systemPrompt String?
  userPrompt   String
  response     String?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  status       AiCallStatus
  error        String?
  userId       String?
  projectId    String?
  createdAt    DateTime     @default(now())

  @@index([feature, createdAt])
}

enum DiscoveryStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  // The founder explicitly paused the interview to continue later. Answers are
  // closed while PAUSED; resuming flips it back to ACTIVE.
  PAUSED
}

// One guided interview per project (the signature feature). The session
// tracks lifecycle; the answers hold the founder's actual input.
model DiscoverySession {
  id          String          @id @default(uuid())
  status      DiscoveryStatus @default(ACTIVE)
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  // The tailored, per-project interview plan generated at session start
  // (JSONB array of { id, module, text, hint? }). Null on legacy sessions —
  // the service then falls back to the deterministic base plan from the
  // question library. Frozen once generated, so progress/resume stay stable.
  questionPlan Json?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @unique // one session per project in V1

  answers DiscoveryAnswer[]
}

// One answer per question per session. `answer` is JSONB: today it's
// { "text": "..." }, later AI follow-ups can add structure without a
// schema migration — exactly what JSONB is for.
model DiscoveryAnswer {
  id           String   @id @default(uuid())
  questionId   String // stable key from the question bank (e.g. "problem.who")
  questionText String // snapshot, so old answers survive question-bank edits
  module       String // interview module, e.g. "problem", "customer"
  answer       Json
  answeredAt   DateTime @default(now())

  session   DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  // Answering the same question again replaces the answer (upsert target).
  @@unique([sessionId, questionId])
}

// Lifecycle of an uploaded PRD/MVP document. Extraction is slow enough
// (seconds, and longer when a scan goes through the vision model) that the
// frontend polls this instead of blocking on the upload response.
enum DocumentStatus {
  UPLOADED   // stored, extraction not started
  EXTRACTING // extraction in flight
  EXTRACTED  // extractedText is populated and usable
  FAILED     // extraction failed; `error` says why
}

// How the text came out of the file — useful for the founder ("we read your
// scan with vision") and for us when debugging a bad pre-fill.
enum DocumentExtractionMethod {
  PDF_TEXT // PDF with a real text layer (unpdf) — no AI cost
  DOCX     // Word document (mammoth) — no AI cost
  VISION   // image, or a PDF with no text layer, read by the AI vision path
}

// A PRD/MVP document a founder uploaded for a project. Fritlow extracts its
// text and uses it to pre-fill the discovery interview, so the founder reviews
// answers instead of retyping a document they already wrote.
//
// The file itself lives in Cloudinary (provenance / re-download); `extractedText`
// is what everything downstream actually reads.
model ProjectDocument {
  id        String         @id @default(uuid())
  fileName  String
  mimeType  String
  sizeBytes Int
  // Cloudinary secure URL + public_id. Null when storage isn't configured —
  // extraction still works, we just can't offer the original back.
  fileUrl   String?
  publicId  String?
  status    DocumentStatus @default(UPLOADED)
  // Populated once status is EXTRACTED. @db.Text because a long PRD blows past
  // Postgres' default varchar sizing.
  extractedText String?                   @db.Text
  extractionMethod DocumentExtractionMethod?
  // How many pages the vision path actually read (it's capped — see
  // document.extract.ts), so we can tell the founder what was skipped.
  pagesRead Int?
  // Failure reason when status is FAILED — shown to the founder verbatim.
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])
  uploadedById String

  @@index([projectId, createdAt])
}

enum BlueprintStatus {
  GENERATING
  READY
  FAILED
}

// The Living Blueprint — one per project, generated from discovery answers,
// then continuously edited. Content lives in sections, not here.
model Blueprint {
  id          String          @id @default(uuid())
  status      BlueprintStatus @default(GENERATING)
  generatedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @unique

  sections BlueprintSection[]
}

// One editable section of the blueprint. `content` is JSONB — today
// { "markdown": "..." }; richer structures (user stories, metrics tables)
// can arrive later without a migration.
model BlueprintSection {
  id        String   @id @default(uuid())
  key       String // stable key, e.g. "problem_statement"
  title     String
  order     Int
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint   Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  blueprintId String

  // Who last edited/restored this section (null for AI-generated content that
  // was never hand-edited). SetNull so deleting that user doesn't block anything.
  updatedBy   User?   @relation("BlueprintSectionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?

  versions BlueprintSectionVersion[]
  comments Comment[]

  @@unique([blueprintId, key])
}

// Version history for the Living Blueprint. Each row is a snapshot of a
// section's content taken BEFORE an edit (or restore) overwrote it — so the
// section table always holds the current text, and this table holds the past.
// `editedById` is the user whose edit displaced this content; restoring never
// deletes forward history, it just snapshots the current text and rolls back.
model BlueprintSectionVersion {
  id            String   @id @default(uuid())
  sectionKey    String // snapshot of the section key, for convenient scoping
  content       Json // { "markdown": "..." } as it was before the edit
  versionNumber Int // 1,2,3… per section, in edit order
  createdAt     DateTime @default(now())

  section            BlueprintSection @relation(fields: [blueprintSectionId], references: [id], onDelete: Cascade)
  blueprintSectionId String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  editedBy           User             @relation(fields: [editedById], references: [id])
  editedById         String

  @@index([blueprintSectionId])
  @@index([projectId])
}

// A discussion note anchored to a blueprint section (the spec anchors comments
// to sections, not projects). Threaded: a reply sets `parentId` to the comment
// it answers; deleting a parent cascades to its replies. `sectionKey` is a
// denormalized snapshot (like BlueprintSectionVersion) for convenient scoping.
model Comment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  section            BlueprintSection @relation(fields: [blueprintSectionId], references: [id], onDelete: Cascade)
  blueprintSectionId String
  sectionKey         String
  author             User             @relation(fields: [authorId], references: [id])
  authorId           String

  // Threading. A top-level comment has parentId = null; a reply points at its
  // parent. onDelete: Cascade so deleting a thread root removes its replies.
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  Comment[] @relation("CommentReplies")

  @@index([blueprintSectionId])
  @@index([projectId])
  @@index([parentId])
}

// A support thread between one end user (the "customer") and Fritlow staff.
// Read state is tracked with two timestamps so each side can compute its own
// unread badge without per-message read rows.
model SupportConversation {
  id              String        @id @default(uuid())
  subject         String?
  status          SupportStatus @default(OPEN)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastMessageAt   DateTime      @default(now()) // denormalized for inbox sorting
  userLastReadAt  DateTime?
  staffLastReadAt DateTime?

  customer   User   @relation("SupportCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  // Which staff member picked it up (optional). SetNull so deleting that staff
  // account just unassigns the thread rather than blocking the delete.
  assignedAdmin   User?   @relation("SupportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAdminId String?

  messages SupportMessage[]

  @@index([customerId])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id         String            @id @default(uuid())
  body       String
  senderType SupportSenderType
  createdAt  DateTime          @default(now())

  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User                @relation("SupportSender", fields: [senderId], references: [id])
  senderId       String

  @@index([conversationId])
}

enum DecisionStatus {
  ACTIVE
  REVISED
  REVERSED
}

// Project AI assistant ("founder copilot"). Conversations are PERSONAL — scoped
// to the project AND their creator — so they cascade away cleanly if either the
// project or the user is deleted (no sentinel needed).
model ChatConversation {
  id            String   @id @default(uuid())
  title         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  messages ChatMessage[]

  @@index([projectId, createdById])
}

model ChatMessage {
  id             String   @id @default(uuid())
  role           ChatRole
  content        String
  createdAt      DateTime @default(now())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId])
}

// Workspace team chat — Slack-style named channels. All workspace members can
// see all channels (public only in V1). Real-time delivery is over Socket.io;
// these tables are the durable history + unread state.
model GroupChannel {
  id            String   @id @default(uuid())
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now()) // denormalized for unread + sorting

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  // Nullable + SetNull: deleting the creator just orphans authorship, not the channel.
  createdBy   User?  @relation("GroupChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  messages GroupMessage[]
  reads    GroupChannelRead[]

  @@index([workspaceId])
  // One channel name per workspace. Enforced in the database because the
  // "create 'general' if none exists" checks in workspace.service run as
  // check-then-insert: under Postgres READ COMMITTED two concurrent
  // transactions can both see no channel and both insert. A unique index is
  // the only thing that sees across concurrent writers — and it also
  // guarantees converting a workspace private → shared → private reuses the
  // existing channel instead of stacking up duplicates.
  @@unique([workspaceId, name])
}

model GroupMessage {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  channel   GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String
  // Required sender; reassigned to the "Deleted User" sentinel on account deletion.
  sender    User   @relation("GroupMessageSender", fields: [senderId], references: [id])
  senderId  String

  @@index([channelId, createdAt])
}

// Per-member read cursor for a channel → drives the unread badge. Personal, so
// it just cascades away when the user (or channel) is deleted.
model GroupChannelRead {
  id         String   @id @default(uuid())
  lastReadAt DateTime @default(now())

  channel   GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([channelId, userId])
}

// An in-app notification for one user. Personal (not shared content), so it just
// cascades away when the user is deleted. `data` is a small JSON blob the
// frontend uses to build the click-through route (no hardcoded URLs server-side).
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// The Decision Log: every major product decision as a first-class object,
// with its reasoning — so the team remembers WHY, months later.
model DecisionLog {
  id        String         @id @default(uuid())
  title     String // "Use Stripe for payments"
  reasoning String
  status    DecisionStatus @default(ACTIVE)
  decidedAt DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String

  @@index([projectId])
}

// What kind of concern a recommendation is about (matches the frontend build
// spec's categories, so the UI can group/icon them).
enum RecommendationType {
  PRICING
  SCOPE
  AUDIENCE
  ONBOARDING
  GENERAL
}

// How urgent the recommendation is, so the founder can triage.
enum RecommendationSeverity {
  INFO
  WARNING
  CRITICAL
}

// Lifecycle. Starts OPEN; the founder then ACKNOWLEDGED (seen/agree),
// DISMISSED (not relevant), or RESOLVED (acted on it).
enum RecommendationStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
  RESOLVED
}

// The AI Product Strategist's output: stored, durable insights ("narrow your
// audience", "pricing needs work") — NOT disposable chat. Generated from the
// project's discovery answers (and blueprint/health score when they exist).
// One project has many. Shape follows the frontend build spec.
model Recommendation {
  id            String                 @id @default(uuid())
  type          RecommendationType     @default(GENERAL)
  title         String // short headline, e.g. "Pricing doesn't match target audience"
  body          String // markdown: why it matters + what to do about it
  severity      RecommendationSeverity @default(WARNING)
  status        RecommendationStatus   @default(OPEN)
  // What triggered it, e.g. "blueprint.business_model" or "health.differentiation".
  sourceContext String?
  // When `status` last changed (set on every status transition) — so the UI can
  // show "Dismissed on …" / "Resolved on …" accurately, not "last edited".
  statusChangedAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

enum ExportFormat {
  PDF
  DOCX
  MARKDOWN
}

// A record of each blueprint export. Files are generated on the fly for V1;
// DO Spaces storage arrives at deploy time.
model Export {
  id        String       @id @default(uuid())
  format    ExportFormat
  createdAt DateTime     @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String

  @@index([projectId])
}

// The Product Health Score: one live score per project, dimensions in JSONB
// ({ key, score, feedback }[]), regenerated on demand.
model HealthScore {
  id         String   @id @default(uuid())
  overall    Int // 0-100
  dimensions Json
  summary    String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String  @unique
}

// Append-only history of every computed health score (the live HealthScore is
// always the latest; this table keeps the trail). Powers the trend/delta
// ("+4.2% since last week") and the history endpoint. One row per computation.
model HealthScoreSnapshot {
  id         String   @id @default(uuid())
  overall    Int
  dimensions Json
  summary    String?
  createdAt  DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId, createdAt])
}

// The core domain object: everything in Fritlow lives inside a project,
// and every project lives inside a workspace (the tenancy rule).
model Project {
  id          String        @id @default(uuid())
  name        String
  oneLineIdea String
  category    String?
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String

  discoverySession       DiscoverySession?
  blueprint              Blueprint?
  decisions              DecisionLog[]
  recommendations        Recommendation[]
  exports                Export[]
  healthScore            HealthScore?
  healthScoreSnapshots   HealthScoreSnapshot[]
  blueprintSectionVersions BlueprintSectionVersion[]
  comments               Comment[]
  chatConversations      ChatConversation[]
  documents              ProjectDocument[]

  @@index([workspaceId])
}

// Join table between User and Workspace, carrying the user's role.
model WorkspaceMember {
  id          String        @id @default(uuid())
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  // A user can only be a member of a given workspace once.
  @@unique([userId, workspaceId])
}

// An invite to join a workspace. EVERY invite lands here first, whether or not
// the email already has a Fritlow account — membership is only created when
// the invitee accepts. Being added to a workspace without consent would put
// someone else's projects in your sidebar on a stranger's say-so.
//
// Two ways an invitation is accepted:
//   - an existing user calls POST /invitations/{id}/accept
//   - a new user registers THROUGH the invite link (the token is the consent)
// Signing up independently leaves the invite PENDING for them to act on.
model WorkspaceInvitation {
  id          String           @id @default(uuid())
  email       String // lowercased, matches the email a future user registers with
  role        WorkspaceRole    @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  // SHA-256 of the token in the emailed link — same pattern as RefreshToken:
  // if the database leaks, the links in it are not usable. Nullable so invites
  // created before this column existed keep working through the in-app list
  // (they just have no clickable email link).
  tokenHash String? @unique
  // Invitations go stale. A PENDING row past this instant is treated as
  // EXPIRED on read, so no scheduled job is needed to sweep them.
  expiresAt DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  invitedById String

  // At most one live invite per (workspace, email). A resend updates the row.
  @@unique([workspaceId, email])
  @@index([email])
}

// Long-lived session tokens. Only a SHA-256 hash is stored — if the DB
// leaks, the tokens themselves remain unusable.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// Single-use tokens proving the user owns their email address, stored hashed
// like the other token tables. Created at registration and on resend.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// Single-use tokens for the forgot-password flow, also stored hashed.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}
