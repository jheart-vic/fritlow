# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection strings (from Neon: Dashboard -> Connect).
# DATABASE_URL = pooled endpoint (host contains "-pooler") — used by the app.
# DIRECT_DATABASE_URL = same string without "-pooler" — used by prisma migrate/studio.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DBNAME?sslmode=require"

# Server
NODE_ENV=development
PORT=4000

# Auth — generate a strong secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# AI layer — pick the provider with AI_PROVIDER; only the SELECTED provider's
# key needs to be set. Leave it empty to run without AI (AI endpoints -> 503).
#   anthropic -> https://console.anthropic.com (Settings -> API keys)
#   openai    -> https://platform.openai.com/account/api-keys
AI_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"     # model used when AI_PROVIDER=anthropic
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"           # model used when AI_PROVIDER=openai
# GPT-5 reasoning effort: minimal | low | medium | high (lower = faster/cheaper)
OPENAI_REASONING_EFFORT=medium

# Email delivery (Brevo) — get a key at https://app.brevo.com (Settings -> SMTP & API -> API keys).
# Leave empty to run without email: sends are skipped and tokens are logged in dev.
BREVO_API_KEY=""
# Sender identity — the address (or its domain) must be verified in Brevo.
EMAIL_FROM_ADDRESS="no-reply@fritlow.com"
EMAIL_FROM_NAME="Fritlow"
# Frontend base URL used for the links inside emails (verify-email / reset-password pages)
APP_URL="http://localhost:3000"

# Platform admin (Fritlow staff). The SUPERADMIN account is provisioned from
# these on startup and NEVER registers — it just logs in via /auth/login with
# these credentials. Leave blank to seed no admin. .env is the source of truth
# for this password (a restart re-syncs it). Use a strong password in prod.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Fritlow Admin"

# Optional. When set, Socket.io (real-time group chat) uses the Redis adapter so
# broadcasts reach clients across multiple server instances. Leave blank for
# single-instance / local dev. Add at deploy when you scale past one instance.
REDIS_URL=""

# Cloudinary — stores user avatar uploads (POST /settings/avatar). All three are
# needed for uploads to work; if any is blank the endpoint returns 503 and the
# rest of the API runs normally. Find them in your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frontend origins allowed to call the API with cookies (comma-separated)
CORS_ORIGIN="http://localhost:3000"
# Set to true in production (HTTPS) — marks the refresh cookie Secure + SameSite=None
COOKIE_SECURE=false

# Rate limiting (auth endpoints). Disabled automatically under NODE_ENV=test.
# Set to false to also turn it off in dev. Windows are in minutes.
RATE_LIMIT_ENABLED=true
# login / register / refresh / verify-email / reset-password — per client IP
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=10
# resend-verification / forgot-password (each spends real Brevo quota) — strictest
EMAIL_RATE_LIMIT_WINDOW_MIN=60
EMAIL_RATE_LIMIT_MAX=3
# Proxy hops in front of the API so req.ip is the real client (Render/Nginx = 1).
# Leave 0 for local dev (no proxy). Required for correct per-IP limiting in prod.
TRUST_PROXY_HOPS=0
